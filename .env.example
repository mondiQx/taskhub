GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_PORT=8765
SLACK_BOT_TOKEN=

# Optional overrides
VAULT_PATH=../../vault
SERVER_PORT=4173

# Optional: local checkout of customizer-core's .claude dir, for read-only
# ticket-history lookups on Jira-sourced tasks. Leave unset if not checked out.
# CUSTOMIZER_CORE_PATH=../../../laravel-docker/core/src/customizer-core/.claude
